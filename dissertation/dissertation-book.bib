@article{Mistry2016,
abstract = {This study evaluated the efficacy of an inquiry-based poverty curriculum unit on students' beliefs about causes of poverty, economic mobility, and helping behaviors. Participants were 89 kindergarten, first- and second-grade students (mean age = 6.81 years, SD = .93) across two intervention and two control classrooms.Students in intervention classrooms participated in a 5- to 7-week curriculum unit focused on poverty. Preintervention results showed no differences in outcomes by condition. Postintervention results indicated that, compared to the control condition, students in the intervention were more likely to say that poverty is malleable over time and less likely to suggest giving money to poor families as a way to help. There were no differences, however, by condition in the types of causal attributions that students provided (i.e., individualistic, fatalistic, and structural). Implications for theory and educational practice regarding teaching about economic inequality and mobility are discussed.},
author = {Mistry, Rashmita S and Nenadal, Lindsey and Griffin, Katherine M and Zimmerman, Frederick J and Cochran, Hasmik Avetisian and Thomas, Carla Anne and Wilson, Christopher},
doi = {10.1111/josi.12193},
file = {:Users/cintiahinojosa/Documents/Mendeley Library//Mistry et al. - 2016 - Children's reasoning about poverty, economic mobility, and helping behavior Results of a curriculum intervention.pdf:pdf},
issn = {15404560},
journal = {Journal of Social Issues},
number = {4},
pages = {760--788},
title = {{Children's reasoning about poverty, economic mobility, and helping behavior: Results of a curriculum intervention in the early school years}},
volume = {72},
year = {2016}
}
@article{Monteith2000,
abstract = {Whites' and Blacks' intergroup attitudes were examined across four samples. Participants wrote essays describing their racial attitudes that were later coded for recurring themes. Coding revealed that Whites and Blacks had similar positive themes, but diverged for negative themes. White participants' most frequently expressed negative attitudes were consistent with the tenets of modern racism theory (McConahay, 1986). These essay themes, as well as modern racism scores, were more strongly related to antiegalitarian sentiments than to the Protestant ethic. Black participants' negative attitudes were described in terms of reactions to perceived racism, and their essay themes were unrelated to both egalitarianism and the Protestant ethic. Discussion focuses on the salient contents of intergroup attitudes, measurement issues, and the potentially different underlying roots of Whites' and Blacks' racial attitudes. {\textcopyright} 2000 Academic Press.},
author = {Monteith, Margo J. and Spicer, C. Vincent},
doi = {10.1006/jesp.1999.1401},
issn = {00221031},
journal = {Journal of Experimental Social Psychology},
number = {2},
pages = {125--154},
title = {{Contents and Correlates of Whites' and Blacks' Racial Attitudes}},
volume = {36},
year = {2000}
}

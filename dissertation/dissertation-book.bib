pages = {288--90},
pmid = {24336237},
title = {{Adverse effects of public health interventions: a conceptual framework.}},
url = {http://jech.bmj.com/lookup/doi/10.1136/jech-2013-203118 http://www.ncbi.nlm.nih.gov/pubmed/24336237},

@article{Felson2018,
abstract = {{\textcopyright} 2018 American Psychological Association. Objective: This study examines general biases and gender biases in blaming victims of rape and other crimes. General biases operate for any type of victimization and can bias attributions of blame downward (sympathy for victims and anger toward offenders) or upward (hindsight). Gender biases can lead to greater victim blaming for rape and female victims. Method: College students were presented with vignettes involving different outcomes and asked whether they blamed the victim (direct blame) and whether they thought the victim was irresponsible or should not have gotten herself in that situation (indirect blame). In Study 1 (N = 348), we manipulated whether the vignette ended with a rape or robbery and included two scenarios in which no negative consequence was mentioned. In Study 2 (N = 239), we manipulated the relationship of the offender and victim, the gender of the victim, and whether the vignette ended in a rape, homicide, assault, or accident. Results: Rape victims were not assigned more blame than other victims. In fact, participants were less likely to assign direct blame to rape victims than robbery victims. They tended to prefer indirect blame over direct blame, particularly in the case of rape and homicide. Conclusions: General biases better explained our results than gender biases. Sympathy for victims and anger toward offenders inhibit victim blaming, whereas hindsight encourages it.},
author = {Felson, Richard B. and Palmore, Christopher},
doi = {10.1037/vio0000168},
file = {:Users/cintiahinojosa/Documents/Mendeley Library//Felson, Palmore - 2018 - Biases in blaming victims of rape and other crime.pdf:pdf},
issn = {2152081X},
journal = {Psychology of Violence},
keywords = {Attributional biases,Gender,Hindsight,Rape,Victim blaming},
number = {3},
pages = {390--399},
title = {{Biases in blaming victims of rape and other crime}},
volume = {8},
year = {2018}
}

keywords = {Criminal justice,Demography,Public health,Social inequality},
number = {34},
pages = {16793--16798},
pmid = {31383756},
title = {{Risk of being killed by police use of force in the United States by age, race–ethnicity, and sex}},
volume = {116},
year = {2019}
}

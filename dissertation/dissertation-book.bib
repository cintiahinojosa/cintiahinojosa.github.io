issn = {19434693},
journal = {Journal of the National Medical Association},
keywords = {Dissimilarity index,Firearm,Homicide,Racial inequality,Residential segregation,Structural racism},
number = {1},
pages = {62--75},
publisher = {Elsevier Inc},
title = {{The Role of Racial Residential Segregation in Black-White Disparities in Firearm Homicide at the State Level in the United States, 1991-2015}},
url = {https://doi.org/10.1016/j.jnma.2018.06.002},
volume = {111},
year = {2019}
}
@article{Koch2016,

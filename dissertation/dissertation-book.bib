volume = {104},
year = {2014}
}
@article{Tuch1996,
abstract = {Objective. Recent race attitude research has focused on the disparity between whites' support for principles of racial equality on the one hand and their intransigence on social policies designed to redress racial inequities on the other, the so-called "principle-implementation gap." Whites' views on racial policy issues and the factors that shape these views are examined in this paper. Methods . Attitudes toward racial policies that span a broad political spectrum are modeled using data from two national surveys, the 1990 General Social Survey and the 1986 American National Election Study. Results. A multicausal interpretation of the principle-policy divide is supported. Structural attribu- tions of the sources of racial inequality, recognition of the embeddedness of discrimination toward blacks, and group self-interest combine to shape whites' racial policy attitudes. Conclusions. Education programs aimed at increasing whites' understanding of the insidious nature of past and present discrimina- tion and of the effects of structured inequality can improve the prospects for successful policy implementation.},
author = {Tuch, Steven A and Hughes, Michael},
file = {:Users/cintiahinojosa/Documents/Mendeley Library/Tuch, Hughes - 1996 - Whites' Racial Policy Attitudes.pdf:pdf},
journal = {Social Science Quarterly},

isbn = {9788578110796},
issn = {1098-6596},
keywords = {icle},
number = {9},
pages = {1689--1699},
pmid = {25246403},
title = {{Judgment and Decision Making Basic Principles of Adaptive Behavior}},
volume = {53},
year = {2019}
}
@misc{Amiel1999,
abstract = {Individuals' attitudes to inequality aversion are measured using survey data, based on the leaky-bucket experiment, for several groups of students in Australia and Israel. Three forms of social welfare function are estimated. It is found that measures of inequality aversion can be obtained with some precision and that these estimates are substantially lower than the values typically used by those measuring inequality and examining optimal tax structures. Furthermore , a welfare function based on the Gini inequality measure is generally found to give a better {\textregistered}t than forms based on constant relative or constant absolute inequality aversion.},
author = {Amiel, Yoram and Creedy, John and Hurn, Stan},

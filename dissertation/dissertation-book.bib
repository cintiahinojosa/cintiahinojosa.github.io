file = {:Users/cintiahinojosa/Documents/Mendeley Library//Tarman, Sears - 2005 - The conceptualization and measurement of symbolic racism.pdf:pdf},
issn = {00223816},
journal = {Journal of Politics},
number = {3},
pages = {731--761},
title = {{The conceptualization and measurement of symbolic racism}},
volume = {67},
year = {2005}
}

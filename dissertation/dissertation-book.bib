pages = {554--559},
title = {{Making the Invisible Visible: Acts of Commission and Omission}},
url = {http://journals.sagepub.com/doi/10.1177/0963721417720959},
volume = {26},
year = {2017}
}
@article{Fryer2010,
abstract = {Using a newly available data set, which allows one to construct a novel measure of a student's social status, we demonstrate that there are potentially important racial differences in the relationship between social status and academic achievement. The effect is concentrated among students with a grade point average (GPA) of 3.5 or higher and more pronounced in schools with more interracial contact. Earlier studies showing a positive relationship between popularity and academic achievement for blacks are sensitive to the inclusion of more continuous achievement measures. We argue that the data are most consistent with a model of 'acting white' in which investments in education are taken as a signal of one's opportunity costs of peer-group loyalty, though imprecise estimates make definitive conclusions difficult. {\textcopyright} 2009.},

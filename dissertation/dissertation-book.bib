@article{Inagaki2017,
abstract = {People who are socially integrated and have strong social ties live happier, longer lives. The link between social connection and well-being is commonly explained in terms of the benefits of receiving care and support from others. However, the benefits of giving care and support to others for the support provider are often overlooked. We review emerging findings that suggest when, why, and how giving support to others provides benefits to the self. We identify possible mechanisms by which these benefits arise and outline boundary conditions that influence such benefits. To gain a richer understanding of the association between social ties and well-being, an important future research direction is to not only consider the support receiver but also emphasize the support provider.},
author = {Inagaki, Tristen K. and Orehek, Edward},

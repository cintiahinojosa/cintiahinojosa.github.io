}
@article{Amir2008,
abstract = {Research in the field of behavioral economics indicates that hum stumble in their decisionmaking in predictable ways that can often b rected by a gentle nudge from the appropriate regulatory authority. Tw books - Dan Ariely 's Predictably Irrational and Richard Thaler and Sunstein's Nudge - recount the findings of behavioral research on pr able patterns in human decisionmaking and lay the foundation for r tion through choice architecture that recognizes these human stumb this Review Essay, we provide a critical account of remaining gaps in b ioral economics research and suggest that some types of behavioral insi may be better translated into law and policy reforms than others. We fu argue that Nudge *s concept of "libertarian paternalism " both under and exaggerates the jurisprudential and policy implications of regulator novation. While key insights from the behavioral field may lead to eff regulation systems with minimal intervention, these systems entail costs distributional effects, solve macro coordination problems, and are inevi value driven. Moreover, policy nudges serve merely as a first stage quenced regulation where, inevitably, more coercive measures are requi later stages. The idea of choice architecture is then related to the gr body of regulatory studies collectively termed "new governance. n We co with a call for a more nuanced account of the range of mechanisms a as the limits, costs, and consequences of applying lessons from the fi behavioral economics to law.},
author = {Amir, On and Lobel, Orly},
file = {:Users/cintiahinojosa/Documents/Mendeley Library/Amir, Lobel - 2008 - Stumble, predit, nudge How behavioral economics informs law and policy.pdf:pdf},

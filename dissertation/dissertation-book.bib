@article{Wright1977,
abstract = {This article examines the influence of racial attitudes on welfare policy in the U.S. The major thesis is that racism is an important determinant of support for public welfare programs, especially Aid to Families with Dependent Children. Racial considerations are argued to be pervasive in U.S. people responses to welfare. The study attempts to demonstrate this in two discrete contexts, individual citizen attitudes and state policy outputs. The argument for expecting support for welfare to be causally related to racial attitudes is stated. There is almost universal acknowledgement of the fundamental importance of racial discrimination as a major cause of African American poverty. There is some support for the belief that race and attitudes toward welfare recipients are linked in the minds of both the mass public and policy makers. Political scientists and economists have given attention to the determinants of welfare and other state policies. Much of their effort has concerned the relative importance of political versus environmental variables in determining public policies. The general conclusion for state welfare expenditures appears to be that both environmental and political variables have important independent effects.},
author = {Wright, Gerald C},

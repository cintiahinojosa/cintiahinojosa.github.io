pages = {305--316},
title = {{The emancipatory potential of transformative mixed methods designs: informing youth participatory action research and restorative practices within a district-wide school transformation project}},
url = {https://www.tandfonline.com/doi/full/10.1080/1743727X.2019.1598355?af=R https://www.tandfonline.com/doi/full/10.1080/1743727X.2019.1598355},

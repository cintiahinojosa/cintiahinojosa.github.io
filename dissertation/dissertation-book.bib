@article{Benford2000,
abstract = {The recent proliferation of scholarship on collective action frames and framing processes in relation to social movements indicates that framing processes have come to be regarded, alongside resource mobilization and political opportunity processes, as a central dynamic in understanding the character and course of social movements. This review examines the analytic utility of the framing literature for un- derstanding social movement dynamics. We first review how collective action frames have been conceptualized, including their characteristic and variable features. We then examine the literature related to framing dynamics and processes. Next we review the literature regarding various contextual factors that constrain and facilitate framing processes. We conclude with an elaboration of the consequences of framing processes for other movement processes and outcomes. We seek throughout to provide clarifi- cation of the linkages between framing concepts/processes and other conceptual and theoretical formulations relevant to social movements, such as schemas and ideology.},
author = {Benford, Robert D and Snow, David A},
file = {:Users/cintiahinojosa/Documents/Mendeley Library//Benford, Snow - 2000 - Framing Processes and Social Movements An Overview and Assessment.pdf:pdf},

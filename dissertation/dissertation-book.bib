@article{Stewart2011,
abstract = {The study outlined in this article drew on Elijah Anderson's (1999) code of the street perspective to examine the impact of neighborhood street culture on violent delinquency. Using data from more than 700 African American adolescents, we examined 1) whether neighborhood street culture predicts adolescent violence above and beyond an adolescent's own street code values and 2) whether neighborhood street culture moderates individual-level street code values on adolescent violence. Consistent with Anderson's hypotheses, neighborhood street culture significantly predicts violent delinquency independent of individual-level street code effects. Additionally, neighborhood street culture moderates individual-level street code values on violence in neighborhoods where the street culture is widespread. In particular, the effect of street code values on violence is enhanced in neighborhoods where the street culture is endorsed widely.},
author = {Stewart, Eric A and Simons, Ronald L},
doi = {10.1111/j.1745-9125.2010.00196.x.RACE},
file = {:Users/cintiahinojosa/Box/Mendeley Library/Stewart, Simons - 2011 - Race, Code of the Street, and Violent Delinquency.pdf:pdf},
journal = {Criminology},
keywords = {1994,2002,and gannon-rowley,behaviors,interest to the effects,morenoff,neighborhoods,of neighborhood context on,problem,sampson,sampson and lauritsen,scholars have devoted renewed,street culture,violent delinquency},
number = {2},
pages = {569--603},
title = {{Race, Code of the Street, and Violent Delinquency}},
volume = {48},
year = {2011}
}

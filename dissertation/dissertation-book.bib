number = {5},
pages = {661},
pmid = {17806662},
series = {LIS Working Paper Series},
title = {{The Paradox of Redistribution and Strategies of Equality: Welfare State Institutions, Inequality, and Poverty in the Western Countries}},
url = {http://hdl.handle.net/10419/160846 http://links.jstor.org/sici?sici=0003-1224%28199810%2963%3A5%3C661%3ATPORAS%3E2.0.CO%3B2-X&origin=crossref},

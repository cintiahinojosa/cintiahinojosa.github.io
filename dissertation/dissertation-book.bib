@article{Hardy2002,
abstract = {Advocacy groups on both sides of the guns issue frequently point to changing personal behavior--of both parents and children-as a key element in reducing gun violence among youth. Efforts to bring about these changes range from community-based cam- paigns, to laws and programs that encourage parents to store their guns safely, to educa- tional initiatives that focus on keeping young children away from guns and encouraging youth to resolve disputes without violence. Unfortunately, these behavior-oriented pro- grams have not shown great success in reducing youth gun violence. This article reviews the research surrounding behavioral approaches to gun violence prevention and highlights obstacles that hamper the effectiveness of these programs.},
author = {Hardy, Marjorie S},
file = {:Users/cintiahinojosa/Documents/Mendeley Library/Hardy - 2002 - Behavior-oriented approaches to reducing youth gun violence.pdf:pdf},
